{
  "hosting": {
    "site": "dompetajaib", "public": "out", "cleanUrls": true,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {"source": "/_next/static/**", "headers": [{"key":"Cache-Control","value":"public,max-age=31536000,immutable"}]},
      {"source": "/sw.js", "headers": [{"key":"Cache-Control","value":"no-cache"}]},
      {"source": "/**", "headers": [{"key":"Cross-Origin-Opener-Policy","value":"same-origin"},{"key":"Cross-Origin-Embedder-Policy","value":"credentialless"},{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"Cache-Control","value":"no-store"}]},
      {"source": "/ocr/**", "headers": [{"key":"Cache-Control","value":"public,max-age=2592000"}]}
    ]
  },
  "firestore": {"rules":"firestore.rules", "indexes":"firestore.indexes.json"}
}
