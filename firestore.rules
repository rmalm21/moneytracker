rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 6.1 Kode akses: the app is for people the owner let in. An account can use its data only with a grant
    // (accessGrants/{uid}), made by the owner or by redeeming one of the owner's codes. The owner (an admin listed in
    // appConfig/access, set once in the Firebase Console) always gets in.
    function adminUid(uid) {
      return exists(/databases/$(database)/documents/appConfig/access)
        && uid in get(/databases/$(database)/documents/appConfig/access).data.get('admins', []);
    }
    function isAdmin() { return request.auth != null && adminUid(request.auth.uid); }
    function allowed() { return exists(/databases/$(database)/documents/accessGrants/$(request.auth.uid)) || isAdmin(); }
    function own(userId) { return request.auth != null && request.auth.uid == userId && allowed(); }
    function canPay(userId, walletId) {
      let wallet = get(/databases/$(database)/documents/users/$(userId)/wallets/$(walletId));
      return wallet.data.get('isArchived', false) == false
        && wallet.data.get('canPay', true) == true;
    }
    // A Split Bill share paid by someone else is spending without any wallet (no money moved yet).
    function splitShareWithoutWallet() {
      return request.resource.data.get('walletId', '') == ''
        && request.resource.data.get('splitBillId', '') is string
        && request.resource.data.get('splitBillId', '') != '';
    }
    function expenseAllowed(userId, previous) {
      return request.resource.data.get('type', '') != 'expense'
        || splitShareWithoutWallet()
        || (previous != null && previous.data.get('type', '') == 'expense'
            && previous.data.get('walletId', '') == request.resource.data.get('walletId', ''))
        || canPay(userId, request.resource.data.get('walletId', ''));
    }
    function validSplitBill(data) {
      return data.title is string && data.title.size() <= 120
        && data.total is int && data.total >= 0
        && data.status in ['draft', 'active', 'cancelled']
        && data.payer in ['me', 'other']
        && data.method in ['equal', 'items', 'amount', 'percent']
        && data.participants is list && data.participants.size() <= 60
        && data.items is list && data.items.size() <= 400
        && data.extras is list && data.extras.size() <= 60
        && data.payments is list && data.payments.size() <= 500;
    }
    // Bunga saldo otomatis: a credited day is an income with its calculation, on the id of its wallet and date
    // (wint_{walletId}_{date}), so a day can exist only once. Other transactions cannot pose as one.
    function interestOk(transactionId) {
      let data = request.resource.data;
      let marked = transactionId.matches('wint_.*');
      return (!marked && !('interest' in data))
        || (marked && 'interest' in data && data.interest is map
            && data.interest.get('source', '') == 'wallet_interest'
            && data.type == 'income' && data.amount is int && data.amount > 0
            && data.interest.get('walletId', '') == data.walletId
            && data.interest.get('date', '') == data.date
            && transactionId == 'wint_' + data.walletId + '_' + data.date);
    }
    function validName(data, longest) { return data.name is string && data.name.size() > 0 && data.name.size() <= longest; }
    // Read by the app to know whether the signed-in account is the owner. Changed only in the Firebase Console.
    match /appConfig/{docId} {
      allow get: if request.auth != null;
      allow list, write: if false;
    }
    // A code: random, one use, with an expiry. Only the owner sees and makes codes. Someone signed in redeems one by
    // writing their own uid on it, in the same batch that creates their grant (each checks the other with getAfter).
    match /accessCodes/{code} {
      allow get, list, create, delete: if isAdmin();
      allow update: if isAdmin()
        || (request.auth != null
            && resource.data.get('usedBy', null) == null
            && resource.data.get('expiresAt', request.time) >= request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt', 'usedEmail'])
            && request.resource.data.usedBy == request.auth.uid
            && getAfter(/databases/$(database)/documents/accessGrants/$(request.auth.uid)).data.code == code);
    }
    match /accessGrants/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list, delete: if isAdmin();
      // The owner keeps a note (a name) on each account; the account itself only marks when it was last active,
      // at most every 6 hours, and nothing else.
      allow update: if isAdmin()
        || (request.auth != null && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen'])
            && request.resource.data.seen == request.time
            && (!('seen' in resource.data) || request.time > resource.data.seen + duration.value(4, 'm')));
      allow create: if isAdmin()
        || (request.auth != null && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['code', 'email', 'at'])
            && request.resource.data.code is string
            && get(/databases/$(database)/documents/accessCodes/$(request.resource.data.code)).data.get('usedBy', null) == null
            && getAfter(/databases/$(database)/documents/accessCodes/$(request.resource.data.code)).data.usedBy == uid);
    }
    // Someone signed in without access asks for it: their email shows in the owner's list (approve or give a code).
    // Only their own request, small, and not more than once a minute.
    match /accessRequests/{uid} {
      // The person sees whether their request is still waiting (the owner may have dismissed it); only the owner
      // removes requests, so asking again needs the owner to have acted first (no create-delete loop).
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list, delete: if isAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'at', 'tries', 'since'])
        && request.resource.data.get('since', '') is string && request.resource.data.get('since', '').size() <= 40
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.at == request.time
        && (resource == null || request.time > resource.data.at + duration.value(1, 'm'));
    }
    // 9.0 Ruang Bersama: records shared by 2–5 members (spaces/{spaceId}), apart from everyone's own (users/{uid}),
    // which stay readable by their owner only. Members are equal; joining takes an invite and a member's approval.
    function space(spaceId) { return get(/databases/$(database)/documents/spaces/$(spaceId)); }
    function memberOf(spaceId) {
      return request.auth != null && allowed() && request.auth.uid in space(spaceId).data.memberIds;
    }
    function inviteDoc(code) { return /databases/$(database)/documents/spaceInvites/$(code); }
    // The member list and the names shown with it always match; at most five members.
    function membersOk(data) {
      return data.memberIds is list && data.memberIds.size() >= 1 && data.memberIds.size() <= 5
        && data.members is map && data.members.keys().toSet() == data.memberIds.toSet();
    }
    function spaceUpdateOk(spaceId) {
      let before = resource.data.memberIds;
      let after = request.resource.data.memberIds;
      return validName(request.resource.data, 40)
        && request.resource.data.createdBy == resource.data.createdBy
        && membersOk(request.resource.data)
        && (
          // Settings (name, colour, period…): nobody added or removed.
          after.toSet() == before.toSet()
          // A member approves one person who asked to join.
          || (after.size() == before.size() + 1 && after.hasAll(before)
              && exists(/databases/$(database)/documents/spaces/$(spaceId)/requests/$(after.removeAll(before)[0])))
          // A member leaves (only themselves; the last member deletes the space instead).
          || (before.size() == after.size() + 1 && before.hasAll(after)
              && request.auth.uid in before && !(request.auth.uid in after))
        );
    }
    match /spaces/{spaceId} {
      allow get, list: if request.auth != null && allowed() && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null && allowed()
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.createdBy == request.auth.uid
        && validName(request.resource.data, 40)
        && membersOk(request.resource.data);
      allow update: if request.auth != null && allowed() && request.auth.uid in resource.data.memberIds && spaceUpdateOk(spaceId);
      // Only the last member removes the space (its records are deleted first, while it still exists).
      allow delete: if request.auth != null && allowed() && resource.data.memberIds == [request.auth.uid];
      // Asking to join: someone holding an unused, unexpired invite of this space, while it has room, uses the invite
      // in the same write (each side checks the other).
      match /requests/{uid} {
        allow get: if request.auth != null && (request.auth.uid == uid || memberOf(spaceId));
        allow list: if memberOf(spaceId);
        allow delete: if (request.auth != null && request.auth.uid == uid) || memberOf(spaceId);
        allow create: if request.auth != null && allowed() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'email', 'code', 'at'])
          && validName(request.resource.data, 60)
          && request.resource.data.email is string && request.resource.data.email.size() <= 120
          && request.resource.data.code is string
          && request.resource.data.at == request.time
          && get(inviteDoc(request.resource.data.code)).data.spaceId == spaceId
          && get(inviteDoc(request.resource.data.code)).data.get('usedBy', null) == null
          && get(inviteDoc(request.resource.data.code)).data.expiresAt > request.time
          && getAfter(inviteDoc(request.resource.data.code)).data.usedBy == uid
          && !(uid in space(spaceId).data.memberIds)
          && space(spaceId).data.memberIds.size() < 5;
      }
      // Riwayat ruang: who added, changed or deleted what. Written by the member who did it; only a restore is
      // noted on it afterwards.
      match /activity/{entryId} {
        allow read, delete: if memberOf(spaceId);
        allow create: if memberOf(spaceId) && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time;
        allow update: if memberOf(spaceId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['restoredBy', 'restoredAt'])
          && request.resource.data.restoredBy == request.auth.uid;
      }
      // 9.2 Chat grup: text, a shared transaction card, or an answer of the assistant asked with "@asisten" (written by
      // the member who asked). Always in the writer's own name, never edited; deleted by its writer, by any member
      // once it is older than 90 days, or by the last member (when the space is being deleted).
      match /messages/{messageId} {
        allow read: if memberOf(spaceId);
        allow create: if memberOf(spaceId)
          && request.resource.data.keys().hasOnly(['by', 'byName', 'at', 'kind', 'text', 'tx', 'bot', 'replyTo', 'mentions'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.kind in ['text', 'tx', 'bot']
          && request.resource.data.text is string && request.resource.data.text.size() <= 2000
          // 9.3 A reply quotes a short piece of the message it answers; tags name at most 5 members.
          && (!('replyTo' in request.resource.data) || (request.resource.data.replyTo is map
            && request.resource.data.replyTo.text is string && request.resource.data.replyTo.text.size() <= 200))
          && (!('mentions' in request.resource.data) || (request.resource.data.mentions is list
            && request.resource.data.mentions.size() <= 5));
        allow delete: if memberOf(spaceId)
          && (resource.data.by == request.auth.uid || resource.data.at < request.time - duration.value(90, 'd')
            || space(spaceId).data.memberIds == [request.auth.uid]);
      }
      // 9.3 Up to where each member has read the group (for "dibaca"): written only by that member, at the server's time.
      match /reads/{uid} {
        allow read: if memberOf(spaceId);
        allow create, update: if memberOf(spaceId) && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['at', 'name']) && request.resource.data.at == request.time;
        allow delete: if memberOf(spaceId) && (request.auth.uid == uid || space(spaceId).data.memberIds == [request.auth.uid]);
      }
      // 9.4 Api bareng: each member's own lit days (for the space's flame), written only by that member.
      match /streak/{uid} {
        allow read: if memberOf(spaceId);
        allow create, update: if memberOf(spaceId) && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['days', 'name', 'at'])
          && request.resource.data.days is list && request.resource.data.days.size() <= 62
          && request.resource.data.at == request.time;
        allow delete: if memberOf(spaceId) && (request.auth.uid == uid || space(spaceId).data.memberIds == [request.auth.uid]);
      }
      match /{collectionName}/{documentId} {
        allow read, write: if memberOf(spaceId) && !(collectionName in ['requests', 'activity', 'messages', 'reads', 'streak']);
      }
    }
    // An invite code: random, one use, valid about a day, made by a member. Whoever holds it can read it (to see which
    // space it is for) and use it once, together with their request to join.
    match /spaceInvites/{code} {
      allow get: if request.auth != null && allowed();
      allow list: if false;
      allow create: if memberOf(request.resource.data.spaceId)
        && code.size() >= 8
        && request.resource.data.keys().hasOnly(['spaceId', 'spaceName', 'inviterName', 'createdBy', 'expiresAt', 'at'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.spaceName is string && request.resource.data.spaceName.size() <= 40
        && request.resource.data.inviterName is string && request.resource.data.inviterName.size() <= 60
        && request.resource.data.at == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(25, 'h');
      allow update: if request.auth != null && allowed()
        && resource.data.get('usedBy', null) == null
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        && request.resource.data.usedBy == request.auth.uid
        && existsAfter(/databases/$(database)/documents/spaces/$(resource.data.spaceId)/requests/$(request.auth.uid));
      allow delete: if memberOf(resource.data.spaceId);
    }
    match /users/{userId} {
      allow read, write: if own(userId);
      match /transactions/{transactionId} {
        allow read, delete: if own(userId);
        allow create: if own(userId) && expenseAllowed(userId, null) && interestOk(transactionId);
        allow update: if own(userId) && expenseAllowed(userId, resource) && interestOk(transactionId);
      }
      // Split Bill: bills, saved people and groups belong to the signed-in user only.
      match /splitBills/{billId} {
        allow read, delete: if own(userId);
        allow create, update: if own(userId) && validSplitBill(request.resource.data);
      }
      match /splitPeople/{personId} {
        allow read, delete: if own(userId);
        allow create, update: if own(userId) && validName(request.resource.data, 60);
      }
      match /splitGroups/{groupId} {
        allow read, delete: if own(userId);
        allow create, update: if own(userId) && validName(request.resource.data, 60)
          && request.resource.data.memberIds is list && request.resource.data.memberIds.size() <= 60;
      }
      match /{collectionName}/{documentId} {
        allow read, write: if own(userId) && !(collectionName in ['transactions', 'splitBills', 'splitPeople', 'splitGroups']);
      }
    }
  }
}
