rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 6.1 Kode akses: the app is for people the owner let in. An account can use its data only with a grant
    // (accessGrants/{uid}), made by the owner or by redeeming one of the owner's codes. The owner (an admin listed in
    // appConfig/access, set once in the Firebase Console) always gets in.
    function adminUid(uid) {
      return exists(/databases/$(database)/documents/appConfig/access)
        && uid in get(/databases/$(database)/documents/appConfig/access).data.get('admins', []);
    }
    function isAdmin() { return request.auth != null && adminUid(request.auth.uid); }
    function allowed() { return exists(/databases/$(database)/documents/accessGrants/$(request.auth.uid)) || isAdmin(); }
    function own(userId) { return request.auth != null && request.auth.uid == userId && allowed(); }
    function canPay(userId, walletId) {
      let wallet = get(/databases/$(database)/documents/users/$(userId)/wallets/$(walletId));
      return wallet.data.get('isArchived', false) == false
        && wallet.data.get('isSpendable', true) == true
        && wallet.data.get('canPay', true) == true;
    }
    // A Split Bill share paid by someone else is spending without any wallet (no money moved yet).
    function splitShareWithoutWallet() {
      return request.resource.data.get('walletId', '') == ''
        && request.resource.data.get('splitBillId', '') is string
        && request.resource.data.get('splitBillId', '') != '';
    }
    function expenseAllowed(userId, previous) {
      return request.resource.data.get('type', '') != 'expense'
        || splitShareWithoutWallet()
        || (previous != null && previous.data.get('type', '') == 'expense'
            && previous.data.get('walletId', '') == request.resource.data.get('walletId', ''))
        || canPay(userId, request.resource.data.get('walletId', ''));
    }
    function validSplitBill(data) {
      return data.title is string && data.title.size() <= 120
        && data.total is int && data.total >= 0
        && data.status in ['draft', 'active', 'cancelled']
        && data.payer in ['me', 'other']
        && data.method in ['equal', 'items', 'amount', 'percent']
        && data.participants is list && data.participants.size() <= 60
        && data.items is list && data.items.size() <= 400
        && data.extras is list && data.extras.size() <= 60
        && data.payments is list && data.payments.size() <= 500;
    }
    // Bunga saldo otomatis: a credited day is an income with its calculation, on the id of its wallet and date
    // (wint_{walletId}_{date}), so a day can exist only once. Other transactions cannot pose as one.
    function interestOk(transactionId) {
      let data = request.resource.data;
      let marked = transactionId.matches('wint_.*');
      return (!marked && !('interest' in data))
        || (marked && 'interest' in data && data.interest is map
            && data.interest.get('source', '') == 'wallet_interest'
            && data.type == 'income' && data.amount is int && data.amount > 0
            && data.interest.get('walletId', '') == data.walletId
            && data.interest.get('date', '') == data.date
            && transactionId == 'wint_' + data.walletId + '_' + data.date);
    }
    function validName(data, longest) { return data.name is string && data.name.size() > 0 && data.name.size() <= longest; }
    // Read by the app to know whether the signed-in account is the owner. Changed only in the Firebase Console.
    match /appConfig/{docId} {
      allow get: if request.auth != null;
      allow list, write: if false;
    }
    // A code: random, one use, with an expiry. Only the owner sees and makes codes. Someone signed in redeems one by
    // writing their own uid on it, in the same batch that creates their grant (each checks the other with getAfter).
    match /accessCodes/{code} {
      allow get, list, create, delete: if isAdmin();
      allow update: if isAdmin()
        || (request.auth != null
            && resource.data.get('usedBy', null) == null
            && resource.data.get('expiresAt', request.time) >= request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt', 'usedEmail'])
            && request.resource.data.usedBy == request.auth.uid
            && getAfter(/databases/$(database)/documents/accessGrants/$(request.auth.uid)).data.code == code);
    }
    match /accessGrants/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list, delete: if isAdmin();
      // The owner keeps a note (a name) on each account; the account itself only marks when it was last active,
      // at most every 6 hours, and nothing else.
      allow update: if isAdmin()
        || (request.auth != null && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen'])
            && request.resource.data.seen == request.time
            && (!('seen' in resource.data) || request.time > resource.data.seen + duration.value(6, 'h')));
      allow create: if isAdmin()
        || (request.auth != null && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['code', 'email', 'at'])
            && request.resource.data.code is string
            && get(/databases/$(database)/documents/accessCodes/$(request.resource.data.code)).data.get('usedBy', null) == null
            && getAfter(/databases/$(database)/documents/accessCodes/$(request.resource.data.code)).data.usedBy == uid);
    }
    // Someone signed in without access asks for it: their email shows in the owner's list (approve or give a code).
    // Only their own request, small, and not more than once a minute.
    match /accessRequests/{uid} {
      // The person sees whether their request is still waiting (the owner may have dismissed it); only the owner
      // removes requests, so asking again needs the owner to have acted first (no create-delete loop).
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list, delete: if isAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'at', 'tries', 'since'])
        && request.resource.data.get('since', '') is string && request.resource.data.get('since', '').size() <= 40
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.at == request.time
        && (resource == null || request.time > resource.data.at + duration.value(1, 'm'));
    }
    match /users/{userId} {
      allow read, write: if own(userId);
      match /transactions/{transactionId} {
        allow read, delete: if own(userId);
        allow create: if own(userId) && expenseAllowed(userId, null) && interestOk(transactionId);
        allow update: if own(userId) && expenseAllowed(userId, resource) && interestOk(transactionId);
      }
      // Split Bill: bills, saved people and groups belong to the signed-in user only.
      match /splitBills/{billId} {
        allow read, delete: if own(userId);
        allow create, update: if own(userId) && validSplitBill(request.resource.data);
      }
      match /splitPeople/{personId} {
        allow read, delete: if own(userId);
        allow create, update: if own(userId) && validName(request.resource.data, 60);
      }
      match /splitGroups/{groupId} {
        allow read, delete: if own(userId);
        allow create, update: if own(userId) && validName(request.resource.data, 60)
          && request.resource.data.memberIds is list && request.resource.data.memberIds.size() <= 60;
      }
      match /{collectionName}/{documentId} {
        allow read, write: if own(userId) && !(collectionName in ['transactions', 'splitBills', 'splitPeople', 'splitGroups']);
      }
    }
  }
}
