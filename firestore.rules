rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function own(userId) { return request.auth != null && request.auth.uid == userId; }
    function canPay(userId, walletId) {
      let wallet = get(/databases/$(database)/documents/users/$(userId)/wallets/$(walletId));
      return wallet.data.get('isArchived', false) == false
        && wallet.data.get('isSpendable', true) == true
        && wallet.data.get('canPay', true) == true;
    }
    // A Split Bill share paid by someone else is spending without any wallet (no money moved yet).
    function splitShareWithoutWallet() {
      return request.resource.data.get('walletId', '') == ''
        && request.resource.data.get('splitBillId', '') is string
        && request.resource.data.get('splitBillId', '') != '';
    }
    function expenseAllowed(userId, previous) {
      return request.resource.data.get('type', '') != 'expense'
        || splitShareWithoutWallet()
        || (previous != null && previous.data.get('type', '') == 'expense'
            && previous.data.get('walletId', '') == request.resource.data.get('walletId', ''))
        || canPay(userId, request.resource.data.get('walletId', ''));
    }
    function validSplitBill(data) {
      return data.title is string && data.title.size() <= 120
        && data.total is int && data.total >= 0
        && data.status in ['draft', 'active', 'cancelled']
        && data.payer in ['me', 'other']
        && data.method in ['equal', 'items', 'amount', 'percent']
        && data.participants is list && data.participants.size() <= 60
        && data.items is list && data.items.size() <= 400
        && data.extras is list && data.extras.size() <= 60
        && data.payments is list && data.payments.size() <= 500;
    }
    // Bunga saldo otomatis: a credited day is an income with its calculation, on the id of its wallet and date
    // (wint_{walletId}_{date}), so a day can exist only once. Other transactions cannot pose as one.
    function interestOk(transactionId) {
      let data = request.resource.data;
      let marked = transactionId.matches('wint_.*');
      return (!marked && !('interest' in data))
        || (marked && 'interest' in data && data.interest is map
            && data.interest.get('source', '') == 'wallet_interest'
            && data.type == 'income' && data.amount is int && data.amount > 0
            && data.interest.get('walletId', '') == data.walletId
            && data.interest.get('date', '') == data.date
            && transactionId == 'wint_' + data.walletId + '_' + data.date);
    }
    function validName(data, longest) { return data.name is string && data.name.size() > 0 && data.name.size() <= longest; }
    match /users/{userId} {
      allow read, write: if own(userId);
      match /transactions/{transactionId} {
        allow read, delete: if own(userId);
        allow create: if own(userId) && expenseAllowed(userId, null) && interestOk(transactionId);
        allow update: if own(userId) && expenseAllowed(userId, resource) && interestOk(transactionId);
      }
      // Split Bill: bills, saved people and groups belong to the signed-in user only.
      match /splitBills/{billId} {
        allow read, delete: if own(userId);
        allow create, update: if own(userId) && validSplitBill(request.resource.data);
      }
      match /splitPeople/{personId} {
        allow read, delete: if own(userId);
        allow create, update: if own(userId) && validName(request.resource.data, 60);
      }
      match /splitGroups/{groupId} {
        allow read, delete: if own(userId);
        allow create, update: if own(userId) && validName(request.resource.data, 60)
          && request.resource.data.memberIds is list && request.resource.data.memberIds.size() <= 60;
      }
      match /{collectionName}/{documentId} {
        allow read, write: if own(userId) && !(collectionName in ['transactions', 'splitBills', 'splitPeople', 'splitGroups']);
      }
    }
  }
}
